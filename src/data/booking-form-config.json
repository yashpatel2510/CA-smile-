  "fields": [
    {
      "id": "fullName",
      "label": "Full Name",
      "type": "text",
      "required": true,
      "enabled": true,
      "placeholder": "e.g. Anish Kumar"
    },
    {
      "id": "mobileNumber",
      "label": "Mobile Number",
      "type": "tel",
      "required": true,
      "enabled": true,
      "placeholder": "Phone Number",
      "helpText": "Primary contact phone number for confirmation"
    },
    {
      "id": "email",
      "label": "Email Address",
      "type": "email",
      "required": false,
      "enabled": true,
      "placeholder": "Email Address (Optional)"
    },
    {
      "id": "preferredDate",
      "label": "Selected Date",
      "type": "date",
      "required": true,
      "enabled": true,
      "helpText": "Appointment date picked from calendar"
    },
    {
      "id": "timeRange",
      "label": "Preferred Time Slot",
      "type": "select",
      "required": true,
      "enabled": true,
      "helpText": "Time slot selected by patient"
    },
    {
      "id": "preferredDoctor",
      "label": "Doctor Preference",
      "type": "select",
      "required": false,
      "enabled": true,
      "helpText": "Allow patient to request a specific clinical specialist"
    },
    {
      "id": "treatment",
      "label": "Treatment or Concern",
      "type": "select",
      "required": true,
      "enabled": true,
      "helpText": "Primary dental procedure or medical symptom"
    },
    {
      "id": "notes",
      "label": "Notes / Symptoms",
      "type": "textarea",
      "required": false,
      "enabled": true,
      "placeholder": "Describe your symptoms, tooth sensitivity, or clinical background..."
    },
    {
      "id": "consentAgreed",
      "label": "Consent Agreement",
      "type": "checkbox",
      "required": true,
      "enabled": true,
      "helpText": "I agree to be contacted to confirm my appointment."
    }
  ],
  "treatments": [
    "General Dental Consultation & Checkup",
    "Pediatric Dentistry & Child Care",
