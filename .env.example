# ==============================================================================
# Clinic Website Platform - Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# Database Connection (PostgreSQL with pooling support if needed)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinic_platform?schema=public"

# Direct connection for Prisma migrations (optional, if using connection pooling like Supabase/Neon)
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clinic_platform?schema=public"

# Email Service Provider API Key (e.g., Resend, SendGrid, Postmark)
EMAIL_API_KEY="re_mock_email_api_key_for_notifications"
EMAIL_FROM="Clinic Notifications <notifications@yourclinicdomain.com>"

# AI Assistant & Clinical Triage API Key (e.g., Google Gemini or OpenAI)
AI_API_KEY="mock_ai_api_key_for_symptom_triage"
AI_MODEL="gemini-1.5-pro"

# Application URL & Tenant Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CLINIC_SLUG="acme-health"
NEXT_PUBLIC_DEFAULT_THEME="teal-serenity"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-hex-string-for-production"

# Google OAuth 2.0 (For Staff & Admin Login)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Clinic Owner / Admin Access Control
OWNER_EMAILS="applei74740@gmail.com"

# Google Places API (For Automatic Live Reviews Sync from Google Maps)
# Obtain from Google Cloud Console -> APIs & Services -> Enable Places API -> Credentials
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
